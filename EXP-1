async function loadMyData() {

    const roll =
        document.getElementById(
            "myRoll"
        ).value;


    const borrowings =
        await api(
            "/api/borrowings?roll=" +
            encodeURIComponent(
                roll
            )
        );


    const fines =
        await api(
            "/api/fines?roll=" +
            encodeURIComponent(
                roll
            )
        );


    let html = `

        <h3>Borrow History</h3>

        <table>

            <tr>

                <th>Book ID</th>
                <th>Issue Date</th>
                <th>Expected Return</th>
                <th>Actual Return</th>
                <th>Status</th>

            </tr>

    `;


    borrowings.forEach(
        borrow => {

            html += `

                <tr>

                    <td>
                        ${borrow.book_id}
                    </td>

                    <td>
                        ${borrow.issue_date}
                    </td>

                    <td>
                        ${borrow.expected_return_date}
                    </td>

                    <td>
                        ${borrow.actual_return_date || ""}
                    </td>

                    <td>
                        ${borrow.status}
                    </td>

                </tr>

            `;

        }
    );


    html += `

        </table>

        <h3>Fine</h3>

        <table>

            <tr>

                <th>Amount</th>
                <th>Status</th>
                <th>Date</th>

            </tr>

    `;


