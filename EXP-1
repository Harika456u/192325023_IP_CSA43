// ================= LOAD STUDENTS =================

async function loadStudents() {

    const students =
        await api(
            "/api/students"
        );


    const table =
        document.getElementById(
            "studentTable"
        );


    table.innerHTML = `

        <tr>

            <th>Name</th>
            <th>Roll</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Department</th>
            <th>Year</th>
            <th>Gender</th>

        </tr>

    `;


    students.forEach(
        student => {

            const row =
                table.insertRow();


            row.insertCell(0)
                .textContent =
                student.name;

            row.insertCell(1)
                .textContent =
                student.roll;

            row.insertCell(2)
                .textContent =
                student.email;

            row.insertCell(3)
                .textContent =
                student.phone;

            row.insertCell(4)
                .textContent =
                student.department;

            row.insertCell(5)
                .textContent =
                student.year;

            row.insertCell(6)
                .textContent =
                student.gender;

        }
    );

}



