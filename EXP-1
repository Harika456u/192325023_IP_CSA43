            <th>Actual Return</th>
            <th>Status</th>

        </tr>

    `;


    borrowings.forEach(
        borrow => {

            const row =
                table.insertRow();


            row.insertCell(0)
                .textContent =
                borrow.roll;

            row.insertCell(1)
                .textContent =
                borrow.book_id;

            row.insertCell(2)
                .textContent =
                borrow.issue_date;

            row.insertCell(3)
                .textContent =
                borrow.expected_return_date;

            row.insertCell(4)
                .textContent =
                borrow.actual_return_date || "";

            row.insertCell(5)
                .textContent =
                borrow.status;

        }
    );

}



