// ================= SEARCH MATERIAL =================

async function searchMaterial() {

    const year =
        document.getElementById(
            "searchYear"
        ).value;


    const semester =
        document.getElementById(
            "searchSemester"
        ).value;


    const materials =
        await api(
            `/api/materials?year=${encodeURIComponent(year)}&semester=${encodeURIComponent(semester)}`
        );


    const result =
        document.getElementById(
            "materialResult"
        );


    if (materials.length === 0) {

        result.innerHTML =
            "No study material found.";

        return;

    }


    let html = `

        <table>

            <tr>

                <th>Title</th>
                <th>Year</th>
                <th>Semester</th>
                <th>File</th>

            </tr>

    `;


    materials.forEach(
        material => {

            html += `

                <tr>

                    <td>
                        ${material.title}
                    </td>

                    <td>
                        ${material.year}
                    </td>

                    <td>
                        ${material.semester}
                    </td>

                    <td>
                        ${material.file_name}
                    </td>

                </tr>

            `;

        }
    );


    html += "</table>";


    result.innerHTML =
        html;

}



