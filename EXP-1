// ================= LOAD BOOKS =================

async function loadBooks() {

    const books =
        await api(
            "/api/books"
        );


    const table =
        document.getElementById(
            "bookTable"
        );


    table.innerHTML = `

        <tr>

            <th>Book ID</th>
            <th>Book Name</th>
            <th>Author</th>
            <th>Category</th>
            <th>Quantity</th>
            <th>Status</th>
            <th>Action</th>

        </tr>

    `;


    books.forEach(
        book => {

            const row =
                table.insertRow();


            row.insertCell(0)
                .textContent =
                book.book_id;

            row.insertCell(1)
                .textContent =
                book.name;

            row.insertCell(2)
                .textContent =
                book.author;

            row.insertCell(3)
                .textContent =
                book.category;

            row.insertCell(4)
                .textContent =
                book.quantity;

            row.insertCell(5)
                .textContent =
                book.status;


            const action =
                row.insertCell(6);


            const edit =
                document.createElement(
                    "button"
                );

            edit.textContent =
                "Edit";


            edit.onclick =
                () => editBook(book);


            action.appendChild(
                edit
            );


            const del =
                document.createElement(
                    "button"
                );

            del.textContent =
                "Delete";


            del.onclick =
                () => deleteBook(book.id);


            action.appendChild(
                del
            );

        }
    );

}



// ================= EDIT BOOK =================

async function editBook(book) {

    const name =
        prompt(
            "Book Name:",
            book.name
        );

    if (name === null)
        return;


    const author =
        prompt(
            "Author:",
            book.author
        );


    const category =
        prompt(
            "Category:",
            book.category
        );


    const quantity =
        prompt(
            "Quantity:",
            book.quantity
        );


    try {

        await api(
            "/api/books/" + book.id,
            {

                method: "PUT",

                body: JSON.stringify({

                    name,
                    author,
                    category,
                    quantity

                })

            }
        );


        loadBooks();
        loadStats();

    }

    catch (error) {

        alert(
            error.message
        );

    }

}



// ================= DELETE BOOK =================

async function deleteBook(id) {

    if (
        !confirm(
            "Delete this book?"
        )
    )
        return;


    try {

        await api(
            "/api/books/" + id,
            {
                method: "DELETE"
            }
        );


        loadBooks();
        loadStats();

    }

    catch (error) {

        alert(
            error.message
        );

    }

}



// ================= SEARCH BOOK =================

async function searchBooks() {

    const search =
        document.getElementById(
            "searchBook"
        ).value;


    const books =
        await api(
            "/api/search-books?q=" +
            encodeURIComponent(
                search
            )
        );


    const result =
        document.getElementById(
            "searchResult"
        );


    if (books.length === 0) {

        result.innerHTML =
            "<p>Book not found.</p>";

        return;

    }


    let html = `

        <table>

        <tr>

            <th>Book ID</th>
            <th>Book Name</th>
            <th>Author</th>
            <th>Category</th>
            <th>Quantity</th>
            <th>Status</th>

        </tr>

    `;


    books.forEach(
        book => {

            html += `

                <tr>

                    <td>${book.book_id}</td>

                    <td>${book.name}</td>

                    <td>${book.author}</td>

                    <td>${book.category}</td>

                    <td>${book.quantity}</td>

                    <td>${book.status}</td>

                </tr>

            `;

        }
    );


    html += "</table>";


    result.innerHTML =
        html;

}



