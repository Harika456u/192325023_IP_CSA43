    <style>

        body {
            font-family: Arial;
            margin: 25px;
            background: #f5f7fa;
        }

        h1 {
            text-align: center;
        }

        .box {
            background: white;
            padding: 20px;
            margin: 20px 0;
            border-radius: 10px;
            box-shadow: 0 2px 8px #ccc;
        }

        input,
        select,
        textarea {
            padding: 10px;
            margin: 5px;
            width: 230px;
        }

        button,
        input[type="submit"] {
            padding: 10px 15px;
            margin: 5px;
            cursor: pointer;
        }

        table {
            border-collapse: collapse;
            width: 100%;
            background: white;
        }

        th,
        td {
            border: 1px solid #999;
            padding: 10px;
        }

        th {
            background: #e6e6e6;
        }

        .hidden {
            display: none;
        }

        .success {
            color: green;
            font-weight: bold;
        }

        .error {
            color: red;
            font-weight: bold;
        }

        .dashboard {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .card {
            padding: 20px;
            background: #eaf2ff;
            min-width: 150px;
            border-radius: 8px;
        }

    </style>

</head>


