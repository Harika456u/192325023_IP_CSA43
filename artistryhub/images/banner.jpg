&lt;html&gt;
&lt;head&gt;
    &lt;title&gt;ArtistryHub&lt;/title&gt;
    &lt;link rel=&quot;stylesheet&quot; href=&quot;style.css&quot;&gt;
&lt;/head&gt;
&lt;body&gt;

&lt;header&gt;
    &lt;h1&gt;ArtistryHub&lt;/h1&gt;
    &lt;p&gt;Emily Harris - Artist Portfolio&lt;/p&gt;
&lt;/header&gt;

&lt;nav&gt;
    &lt;a href=&quot;index.php&quot;&gt;Home&lt;/a&gt;
    &lt;a href=&quot;about.php&quot;&gt;About&lt;/a&gt;
    &lt;a href=&quot;portfolio.php&quot;&gt;Portfolio&lt;/a&gt;
    &lt;a href=&quot;catalogue.php&quot;&gt;Catalogue&lt;/a&gt;
    &lt;a href=&quot;gallery.php&quot;&gt;Gallery&lt;/a&gt;
    &lt;a href=&quot;news.php&quot;&gt;News&lt;/a&gt;
    &lt;a href=&quot;store.php&quot;&gt;Store&lt;/a&gt;
    &lt;a href=&quot;contact.php&quot;&gt;Contact&lt;/a&gt;
&lt;/nav&gt;

&lt;section class=&quot;banner&quot;&gt;
    &lt;h1&gt;Welcome to ArtistryHub&lt;/h1&gt;
    &lt;p&gt;Discover the world of creativity and imagination&lt;/p&gt;
    &lt;a class=&quot;btn&quot; href=&quot;portfolio.php&quot;&gt;Explore Artwork&lt;/a&gt;
&lt;/section&gt;

&lt;h2&gt;Featured Artworks&lt;/h2&gt;

&lt;div class=&quot;gallery&quot;&gt;
    &lt;img src=&quot;images/sunset.jpg&quot;&gt;
    &lt;img src=&quot;images/ocean.jpg&quot;&gt;
    &lt;img src=&quot;images/nature.jpg&quot;&gt;
&lt;/div&gt;

&lt;footer&gt;ArtistryHub | Emily Harris Portfolio&lt;/footer&gt;

