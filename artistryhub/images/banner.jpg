require &quot;db.php&quot;;
$result = $conn-&gt;query(&quot;SELECT * FROM artworks&quot;);
?&gt;

&lt;link rel=&quot;stylesheet&quot; href=&quot;style.css&quot;&gt;

&lt;header&gt;&lt;h1&gt;Artwork Catalogue&lt;/h1&gt;&lt;/header&gt;

&lt;table&gt;
&lt;tr&gt;
    &lt;th&gt;ID&lt;/th&gt;
    &lt;th&gt;Artwork&lt;/th&gt;
    &lt;th&gt;Description&lt;/th&gt;
    &lt;th&gt;Release Date&lt;/th&gt;
    &lt;th&gt;Price&lt;/th&gt;
&lt;/tr&gt;

&lt;?php while($r = $result-&gt;fetch_assoc()){ ?&gt;

&lt;tr&gt;
    &lt;td&gt;&lt;?= $r['id'] ?&gt;&lt;/td&gt;
    &lt;td&gt;&lt;?= e($r['title']) ?&gt;&lt;/td&gt;
    &lt;td&gt;&lt;?= e($r['description']) ?&gt;&lt;/td&gt;
    &lt;td&gt;&lt;?= e($r['release_date']) ?&gt;&lt;/td&gt;
    &lt;td&gt;₹&lt;?= e($r['price']) ?&gt;&lt;/td&gt;
&lt;/tr&gt;

&lt;?php } ?&gt;

&lt;/table&gt;

