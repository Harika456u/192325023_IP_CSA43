    margin: 0;
    font-family: Arial, sans-serif;
    background: #faf6ef;
    color: #49352b;
    text-align: center;
}

header, footer {
    background: #49352b;
    color: white;
    padding: 25px;
}

nav {
    background: #795548;
    padding: 18px;
}

nav a {
    color: white;
    margin: 12px;
    text-decoration: none;
}

nav a:hover {
    color: gold;
}

.banner {
    background: linear-gradient(#0005,#0005),
                url(&quot;images/banner.jpg&quot;) center/cover;
    padding: 110px 20px;
    color: white;
}

.banner h1 {
    font-size: 45px;
}

.gallery {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 25px;
    padding: 30px;
}

.gallery img {
    width: 280px;
    height: 220px;
    object-fit: cover;
    border-radius: 10px;
    cursor: pointer;
}

.card, .panel {
    background: white;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 4px 12px #ccc;
}

.panel {
    max-width: 600px;
    margin: 30px auto;
}

form {
    background: white;
    max-width: 350px;
    margin: 25px auto;
    padding: 20px;
    border-radius: 10px;
}

input, textarea {
    width: 100%;
    padding: 12px;
    margin: 8px 0;
    box-sizing: border-box;
    border: 1px solid #ccc;
    border-radius: 5px;
}

button, .btn {
    background: #795548;
    color: white;
    padding: 12px 22px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    text-decoration: none;
}

a {
    color: #795548;
}

table {
    width: 90%;
    margin: 30px auto;
    border-collapse: collapse;
    background: white;
}

th, td {
    padding: 15px;
    border: 1px solid #ccc;
}

th {
    background: #49352b;
    color: white;
}

#preview {
    display: none;
    position: fixed;
    inset: 0;
    background: #000d;
    justify-content: center;
    align-items: center;
    cursor: pointer;
}

#preview img {
    max-width: 90%;
    max-height: 90%;
}" class="CodeBlock-zu1QM3"><div data-code-block="true" data-markdown-copy="code-block" data-theme="dark" class="relative Root-iW7ipz w-full min-w-0 contain-inline-size overflow-clip rounded-(--radius-3xl-base) border border-subtle text-default CodeSurface-UAMd1A dark @container" data-search-result-target=""><div data-markdown-copy="exclude" contenteditable="false" class="flex items-center font-sans text-sm select-none gap-2 ActionBar-KWWAct min-h-12 py-1.5 ps-4 pe-1.5 font-medium text-default md:ps-5 sticky z-10 StickyActionBar-RZfVQh"><svg aria-hidden="true" class="Icon-X4VkKC" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-76249a17b736e543.svg#codex-icon-code-light-20" fill="currentColor"></use></svg><div class="min-w-0 truncate flex-1">CSS</div><div class="ms-auto flex items-center min-w-0 max-w-full"><div data-code-block-controls="true" role="presentation" class="flex min-w-0 items-center gap-px print:hidden flex-wrap justify-end"><button type="button" class="no-drag cursor-interaction items-center select-none disabled:cursor-default aria-disabled:cursor-default focus:outline-hidden disabled:opacity-40 aria-disabled:opacity-40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-0 whitespace-nowrap flex border gap-1 rounded-full text-default not-disabled:not-aria-disabled:hover:bg-secondary-ghost-hover data-[state=open]:bg-secondary-ghost-hover aria-pressed:bg-secondary-ghost-hover border-transparent [[data-control-group]_&amp;]:not-disabled:not-aria-disabled:active:bg-secondary-ghost-active h-9 gap-1.5 border-0 px-2 py-0 text-sm leading-5 aspect-square shrink-0 items-center justify-center !px-0" aria-label="Enable word wrap" aria-pressed="false" data-state="closed"><svg aria-hidden="true" class="Icon-X4VkKC" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-76249a17b736e543.svg#codex-icon-tex