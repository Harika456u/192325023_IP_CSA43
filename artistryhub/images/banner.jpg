    </span><span class="text-codex-syntax-attribute">border-collapse</span><span>: </span><span class="text-codex-syntax-literal">collapse</span><span>;
    </span><span class="text-codex-syntax-attribute">background</span><span>: </span><span class="text-codex-syntax-literal">white</span><span>;
}

</span><span class="text-codex-syntax-name">th</span><span>, </span><span class="text-codex-syntax-name">td </span><span>{
    </span><span class="text-codex-syntax-attribute">padding</span><span>: </span><span class="text-codex-syntax-literal">15px</span><span>;
    </span><span class="text-codex-syntax-attribute">border</span><span>: </span><span class="text-codex-syntax-literal">1px solid </span><span class="text-codex-syntax-string">#ccc</span><span>;
}

</span><span class="text-codex-syntax-name">th </span><span>{
    </span><span class="text-codex-syntax-attribute">background</span><span>: </span><span class="text-codex-syntax-string">#49352b</span><span>;
    </span><span class="text-codex-syntax-attribute">color</span><span>: </span><span class="text-codex-syntax-literal">white</span><span>;
}

</span><span class="text-codex-syntax-attribute">#preview </span><span>{
    </span><span class="text-codex-syntax-attribute">display</span><span>: </span><span class="text-codex-syntax-literal">none</span><span>;
    </span><span class="text-codex-syntax-attribute">position</span><span>: </span><span class="text-codex-syntax-literal">fixed</span><span>;
    </span><span class="text-codex-syntax-attribute">inset</span><span>: </span><span class="text-codex-syntax-literal">0</span><span>;
    </span><span class="text-codex-syntax-attribute">background</span><span>: </span><span class="text-codex-syntax-string">#000d</span><span>;
    </span><span class="text-codex-syntax-attribute">justify-content</span><span>: </span><span class="text-codex-syntax-literal">center</span><span>;
    </span><span class="text-codex-syntax-attribute">align-items</span><span>: </span><span class="text-codex-syntax-literal">center</span><span>;
    </span><span class="text-codex-syntax-attribute">cursor</span><span>: </span><span class="text-codex-syntax-literal">pointer</span><span>;
}

</span><span class="text-codex-syntax-attribute">#preview </span><span class="text-codex-syntax-name">img </span><span>{
    </span><span class="text-codex-syntax-attribute">max-width</span><span>: </span><span class="text-codex-syntax-literal">90%</span><span>;
    </span><span class="text-codex-syntax-attribute">max-height</span><span>: </span><span class="text-codex-syntax-literal">90%</span><span>;
}</span></code></pre></div></div></div><button class="group/scroll-to-bottom cursor-interaction absolute z-30 flex h-8 translate-x-1/2 items-center justify-center rounded-full text-secondary transition-[width,opacity] duration-120 ease-out motion-reduce:transition-none end-1/2 print:hidden w-8 pointer-events-none opacity-0 bottom-4" aria-hidden="true" aria-label="Scroll to bottom" tabindex="-1" type="button"><span class="pointer-events-none flex h-full shrink-0 items-center justify-center rounded-full border border-default bg-surface bg-clip-padding shadow-md transition-[width] duration-120 ease-out motion-reduce:transition-none w-8"><svg aria-hidden="true" class="Icon-X4VkKC text-default" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-76249a17b736e543.svg#codex-icon-arrow-down-lg-light-20" fill="currentColor"></use></svg></span></button></div></div></div></div><h1 class="TextBase-kDAqPL Title-ij922C" data-d-text-flow="" data-d-component="title" data-d-size="xl" data-d-weight="semibold"><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);"><strong class="Emphasis-BHzYtQ">Step 18: Run the application</strong></span></h1><p class="TextBase-kDAqPL Text-dOmvsS" data-d-text-flow="" data-d-component="text"><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);">Press </span><span class="TextBase-kDAqPL Text-dOmvsS" data-d-text-flow="" data-d-component="text" data-d-default-strong="" data-d-inline=""><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);"><strong class="Emphasis-BHzYtQ">Ctrl + K, then Ctrl + S</strong></span></span><span data-d-stream-run="" data-d-text-flow="run" style="--d-stream-ink: rgb(237, 237, 237);"> to save all files in VS Code.</span></p><p class="TextBase-kDAqPL Text-dOmvsS" data-d-text-flow="" data-d-component="text"><span data-d-stream-run="" data-d-tex